{
  "name": "gitlab-mcp-server",
  "version": "1.1.0",
  "description": "GitLab MCP server using TypeScript SDK and stdio transport",
  "type": "module",
  "bin": {
    "gitlab-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@gitbeaker/rest": "^43.0.0",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "commander": "^13.1.0",
